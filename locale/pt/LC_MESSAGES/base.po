#: src/health_data_parser/cli/diagnostic_reports.py:13
msgid ""
"\n"
"Usage:\n"
"\n"
"   $ health-data-parser-reports path/to/observation_data.csv [options]\n"
"\n"
"Writes the observations in the CSV as DiagnosticReport JSON files next to it.\n"
"\n"
"    -h, --help\n"
"        Print this help text\n"
"\n"
"    -v, --verbose\n"
"        Run in verbose mode\n"
msgstr ""
" Uso:\n"
"\n"
"   $ health-data-parser-reports path/to/observation_data.csv [options]\n"
"\n"
"Escreve as observações no CSV como arquivos JSON DiagnosticReport ao lado.\n"
"\n"
"    -h, --help\n"
"        Exibe este texto de ajuda\n"
"\n"
"    -v, --verbose\n"
"        Executa no modo detalhado "

#: src/health_data_parser/cli/parse.py:17
msgid ""
"Parse an Apple Health export (plus optional custom data) into a PDF report "
"and JSON/CSV/text files."
msgstr ""
"Analisar uma exportação do Apple Health (com dados personalizados opcionais)"
" em um relatório PDF e arquivos JSON/CSV/texto."

#: src/health_data_parser/cli/parse.py:20
msgid "Apple Health export directory (containing clinical-records/)"
msgstr "Diretório de exportação do Apple Health (contém clinical-records/)"

#: src/health_data_parser/cli/parse.py:30
msgid ""
"Write outputs here instead of the export directory (created if missing)"
msgstr ""
"Escreva as saídas aqui em vez do diretório de exportação (criado se não "
"existir)"

#: src/health_data_parser/cli/parse.py:32
msgid "Do not parse export.xml (much faster)"
msgstr "Não analisar export.xml (muito mais rápido)"

#: src/health_data_parser/cli/parse.py:33
msgid "Exclude results from before this year"
msgstr "Excluir resultados anteriores a este ano"

#: src/health_data_parser/cli/parse.py:35
msgid "Exclude results from these dates (comma-separated, YYYY-MM-DD)"
msgstr "Excluir resultados destas datas (separadas por vírgula, AAAA-MM-DD)"

#: src/health_data_parser/cli/parse.py:37
msgid ""
"Exclude observations with excessively long result values (full diagnostic "
"report text mixed into a single observation)"
msgstr ""
"Excluir observações com valores de resultado excessivamente longos (texto "
"completo do relatório diagnóstico misturado em uma única observação)"

#: src/health_data_parser/cli/parse.py:40
msgid ""
"Only collect abnormal results that are out of range, not those near the ends"
" of their range"
msgstr ""
"Coletar apenas resultados anômalos fora do intervalo, não os que estão perto"
" dos limites do seu intervalo"

#: src/health_data_parser/cli/parse.py:43
msgid ""
"How close to either end of a range counts as abnormal (default 0.15, i.e. "
"15%%; absolute value must be under 0.5)"
msgstr ""
"Quão próximo de qualquer extremidade de um intervalo conta como anormal "
"(padrão 0.15, ou seja, 15%%; o valor absoluto deve ser inferior a 0.5)"

#: src/health_data_parser/cli/parse.py:46
msgid ""
"Laboratory data not in Apple Health, in the format of "
"sample_templates/sample_observations_data.csv"
msgstr ""
"Dados de laboratório não estão no Apple Health, no formato "
"sample_templates/sample_observations_data.csv"

#: src/health_data_parser/cli/parse.py:49
msgid "Current and past symptoms, for a timeline chart in the PDF report"
msgstr ""
"Sintomas atuais e passados para o gráfico de linha do tempo no relatório PDF"

#: src/health_data_parser/cli/parse.py:51
msgid "Food log, for nutrition charts in the PDF report"
msgstr "Registro de alimentos, para gráficos nutricionais no relatório PDF"

#: src/health_data_parser/cli/parse.py:53
msgid ""
"Highlight abnormal results in the report's observation tables (default true)"
msgstr ""
"Realçar resultados anormais nas tabelas de observação do relatório (padrão "
"true)"

#: src/health_data_parser/cli/parse.py:55
#: src/health_data_parser/gui/run_panel.py:77
msgid "Subject birth date for the report, if not found in export.xml"
msgstr ""
"Data de nascimento do sujeito para o relatório, se não encontrada em "
"export.xml"

#: src/health_data_parser/cli/parse.py:57
msgid ""
"Include every vital sign reading in observations.json (can be large with a "
"wearable)"
msgstr ""
"Incluir todas as leituras de sinais vitais em observations.json (pode ser "
"grande com um wearable)"

#: src/health_data_parser/cli/parse.py:60
msgid ""
"Skip the Apple Health export data; report only on the custom files given"
msgstr ""
"Ignorar os dados de exportação do Apple Health; relatar somente os arquivos "
"personalizados fornecidos"

#: src/health_data_parser/cli/parse.py:61
msgid "Log more detail"
msgstr "Registrar mais detalhes"

